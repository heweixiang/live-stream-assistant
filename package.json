{
  "name": "live-assistant-workspace",
  "private": true,
  "scripts": {
    "core": "python core/server.py --mode idle",
    "core:mock": "python core/server.py --mode mock",
    "tts": ".venv-melo/Scripts/python.exe core/tts_server.py --preload",
    "app": "npm --prefix app run electron:dev",
    "app:admin": "npm --prefix app run electron:dev:admin",
    "pack": "npm --prefix app run pack",
    "dev": "echo 请开三个终端：npm run core / npm run tts / npm run app"
  }
}
