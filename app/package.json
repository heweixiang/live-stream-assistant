{
  "name": "live-assistant",
  "private": true,
  "version": "0.1.0-beta.1",
  "description": "抖音直播助手桌面端",
  "author": "直播助手",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "electron:build": "npm run build && electron .",
    "pack": "npm run build && cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --win portable --x64 && node scripts/sync-desktop.cjs",
    "pack:sync": "node scripts/sync-desktop.cjs"
  },
  "dependencies": {
    "splitpanes": "^4.1.2",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "typescript": "~5.9.3",
    "vite": "^7.1.3",
    "vue-tsc": "^3.0.6",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.liveassistant.desktop",
    "productName": "直播助手",
    "copyright": "Copyright © 直播助手",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "直播助手-${version}-portable.exe",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "直播助手-${version}-portable.exe"
    }
  }
}
